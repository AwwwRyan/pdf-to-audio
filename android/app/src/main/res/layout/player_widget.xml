<?xml version="1.0" encoding="utf-8"?>
<!-- @android:id/background lets Android 12+ animate the launch from the widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:src="@mipmap/ic_launcher" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_empty_title"
            android:textColor="@color/widget_on_surface"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_empty_subtitle"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="@color/widget_track"
            android:progressTint="@color/widget_accent"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_rewind"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_button_ripple"
        android:contentDescription="@string/widget_rewind">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_rotate_ccw"
            android:tint="@color/widget_on_surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:text="10"
            android:textColor="@color/widget_on_surface"
            android:textSize="8sp"
            android:textStyle="bold" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp">

        <ImageView
            android:id="@+id/widget_play"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_play_background"
            android:contentDescription="@string/widget_play"
            android:padding="13dp"
            android:src="@drawable/ic_widget_play"
            android:tint="@color/widget_on_accent" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_forward"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_button_ripple"
        android:contentDescription="@string/widget_forward">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_rotate_cw"
            android:tint="@color/widget_on_surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:text="10"
            android:textColor="@color/widget_on_surface"
            android:textSize="8sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
